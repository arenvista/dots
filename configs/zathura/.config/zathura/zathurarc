
set synctex-editor-command "nvim --remote-silent +%{line} %{input}"
set synctex true
# ==========================================
# General Settings
# ==========================================
# Copy selected text to the system clipboard (instead of primary selection)
set selection-clipboard clipboard

# Automatically fit the document to the window width when opened
set adjust-open "width"

# Smooth scrolling settings
set scroll-page-aware true
set smooth-scroll true
set scroll-step 50

# Set the font for the status bar and index
set font "monospace 10"

# Hide the status bar by default (press 'Ctrl + m' to toggle)
# set optionsbar-hidden true 

# ==========================================
# Document Recoloring (Dark Mode)
# ==========================================
# Automatically invert pages to dark mode (Toggle on/off with Ctrl + r)
set recolor true

# Keep the original colors of images and links when recoloring
set recolor-keephue true

# ==========================================
# PyWal Colors
# ==========================================
set default-bg "#321f28"
set default-fg "#e8c7bc"
set statusbar-bg "#321f28"
set statusbar-fg "#e8c7bc"
set inputbar-bg "#321f28"
set inputbar-fg "#e8c7bc"
set notification-bg "#321f28"
set notification-fg "#e8c7bc"
set notification-error-bg "#5176B5"
set notification-error-fg "#e8c7bc"
set notification-warning-bg "#CA7883"
set notification-warning-fg "#321f28"
set highlight-color "rgba(89, 130, 189, 0.2)"
set highlight-active-color "rgba(169, 145, 155, 0.5)"
set completion-bg "#321f28"
set completion-fg "#e8c7bc"
set completion-highlight-bg "#5982BD"
set completion-highlight-fg "#321f28"
set recolor-lightcolor "#321f28"
set recolor-darkcolor "#e8c7bc"
