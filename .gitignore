# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- uv -------------------------------------------------------------------
# uv.lock IS tracked on purpose: it pins the TUI's dependencies.
.uv/

# --- generated by the manager ---------------------------------------------
# Written fresh from profile.toml every time you confirm an install.
.manager-install.sh

# profile.toml is NOT ignored: it records which features this machine wants,
# which is worth committing. Drop it here if it should stay machine-local.

# --- stow package build artifacts -----------------------------------------
# `yarn install` in configs/nvim/.config/ leaves these beside the nvim/ dir,
# where stow would link them into ~/.config/ root. Also see
# configs/nvim/.stow-local-ignore, which keeps stow itself away from them.
configs/nvim/.config/node_modules/
configs/nvim/.config/package-lock.json
configs/nvim/.config/yarn.lock

# applwal.sh rewrites the firefox start page's background on every wallpaper
# change, and ~/.config/firefox is stow-linked back into this package, so the
# resized copy would otherwise churn in the tree as a ~500KB binary diff.
configs/firefox/.config/firefox/current.jpg
configs/firefox/.config/firefox/todo.js

# --- editor / OS ----------------------------------------------------------
*.swp
*.swo
.DS_Store
